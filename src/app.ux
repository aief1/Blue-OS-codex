<script>
import fetch from '@blueos.network.fetch'
import notificationManager from '@blueos.app.notification.notificationManager'
import schedule from '@blueos.app.appmanager.schedule'
import storage from '@blueos.storage.storage'

// 只需在这里配置一次，页面刷新和后台完成通知会共用它。
const MONITOR_URL = ''
const MONITOR_TOKEN = ''
const POLL_INTERVAL_MS = 15000

const ACTIVE_TASKS_KEY = 'codexPulse.activeTasks.v1'
const SCHEDULE_ID_KEY = 'codexPulse.scheduleId.v1'
const NOTIFICATION_ICON = '/watch3001/assets/3001.png'

function readSetting(key, fallback) {
  try {
    const value = storage.getSync({ key: key })
    return value ? String(value) : fallback
  } catch (error) {
    return fallback
  }
}

function parseSnapshot(raw) {
  if (typeof raw !== 'string') {
    return raw
  }
  try {
    return JSON.parse(raw)
  } catch (error) {
    return null
  }
}

function readPreviousTasks() {
  try {
    const raw = storage.getSync({ key: ACTIVE_TASKS_KEY })
    if (!raw) {
      return null
    }
    const tasks = JSON.parse(String(raw))
    return Array.isArray(tasks) ? tasks : null
  } catch (error) {
    return null
  }
}

function writeTasks(tasks) {
  storage.set({
    key: ACTIVE_TASKS_KEY,
    value: JSON.stringify(tasks)
  })
}

function activeTasksFrom(snapshot) {
  const activity = snapshot && snapshot.activity ? snapshot.activity : {}
  if (Array.isArray(activity.items)) {
    return activity.items.map((item) => ({
      id: String(item.id || ''),
      title: String(item.title || 'Codex 任务')
    })).filter((item) => item.id)
  }
  if (activity.running) {
    return [{ id: 'legacy-active-task', title: String(activity.title || 'Codex 任务') }]
  }
  return []
}

function publishCompletion(tasks) {
  const count = tasks.length
  const text = count === 1 ? tasks[0].title : count + ' 个 Codex 任务已完成'
  notificationManager.publish({
    request: {
      id: Date.now() % 2147483647,
      appName: 'Codex脉冲',
      icon: NOTIFICATION_ICON,
      contentType: 1,
      content: {
        title: 'Codex 任务已完成',
        text: text
      },
      channel: 2,
      deliveryTime: Date.now(),
      group: 'codex-completion'
    },
    success: () => {},
    fail: () => {},
    complete: () => {}
  })
}

export default {
  onCreate() {
    this.installCompletionWatcher()
  },

  installCompletionWatcher() {
    const monitorUrl = readSetting('codexPulse.monitorUrl.v1', MONITOR_URL)
    if (!monitorUrl) {
      return
    }

    try {
      const previousId = Number(storage.getSync({ key: SCHEDULE_ID_KEY }) || 0)
      if (previousId > 0) {
        return
      }
    } catch (error) {}

    schedule.scheduleJob({
      type: 2,
      timeout: POLL_INTERVAL_MS,
      interval: POLL_INTERVAL_MS,
      triggerMethod: 'checkTaskCompletion',
      params: {},
      success: (data) => {
        storage.set({ key: SCHEDULE_ID_KEY, value: String(data.id) })
      },
      fail: () => {},
      complete: () => {}
    })
  },

  checkTaskCompletion() {
    const monitorUrl = readSetting('codexPulse.monitorUrl.v1', MONITOR_URL)
    const monitorToken = readSetting('codexPulse.monitorToken.v1', MONITOR_TOKEN)
    if (!monitorUrl) {
      return
    }

    const headers = { 'Accept': 'application/json' }
    if (monitorToken) {
      headers['X-Codex-Watch-Token'] = monitorToken
    }

    fetch.fetch({
      url: monitorUrl,
      method: 'GET',
      header: headers,
      responseType: 'json',
      success: (response) => {
        if (response.code < 200 || response.code >= 300) {
          return
        }
        const snapshot = parseSnapshot(response.data)
        if (!snapshot || !snapshot.ok) {
          return
        }

        const current = activeTasksFrom(snapshot)
        const previous = readPreviousTasks()
        writeTasks(current)

        // 第一次成功同步只建立基线，避免把安装前结束的任务误报为新完成。
        if (previous === null) {
          return
        }

        const currentIds = {}
        current.forEach((task) => {
          currentIds[task.id] = true
        })
        const completed = previous.filter((task) => !currentIds[task.id])
        if (completed.length > 0) {
          publishCompletion(completed)
        }
      },
      fail: () => {}
    })
  }
}
</script>
